{
  "name": "voice-pilot",
  "private": true,
  "description": "Hands-free voice control for NSPIRE inspection apps: earbuds, local matching, Jev fallback, Kokoro voice, learning loop.",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "bundle": "esbuild tools/bundle_entry.ts --bundle --format=iife --target=es2020 --outfile=voicePilot.bundle.js",
    "bookmarklet": "esbuild tools/bookmarklet_entry.ts --bundle --minify --format=iife --target=es2020 --outfile=tools/bookmarklet.js",
    "harness": "esbuild tools/setup_harness/main.tsx --bundle --format=iife --jsx=automatic --target=es2020 --outfile=tools/setup_harness/app.js --define:process.env.NODE_ENV='\"production\"'"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "~5.8.2"
  }
}
